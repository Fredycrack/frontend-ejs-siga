<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGA - Nuevo Empleado</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <h1>SIGA - AGROSERVICES</h1>
    <div class="navbar-links">
      <a href="/empleados">&larr; Volver</a>
      <a href="/logout">Cerrar Sesion</a>
    </div>
  </nav>

  <div class="container">
    <div class="card">
      <h1>Crear Nuevo Empleado</h1>

      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>

      <form action="/empleados/crear" method="POST">
        <div class="grid-2">
          <div class="form-group">
            <label for="nombre">Nombre:</label>
            <input type="text" id="nombre" name="nombre" required>
          </div>
          <div class="form-group">
            <label for="documento">Documento:</label>
            <input type="text" id="documento" name="documento" required>
          </div>
          <div class="form-group">
            <label for="email">Email:</label>
            <input type="email" id="email" name="email" required>
          </div>
          <div class="form-group">
            <label for="telefono">Telefono:</label>
            <input type="text" id="telefono" name="telefono">
          </div>
          <div class="form-group">
            <label for="password">Contrasena:</label>
            <input type="password" id="password" name="password" required>
          </div>
          <div class="form-group">
            <label for="rol">Rol:</label>
            <select id="rol" name="rol" required>
              <option value="Administrador">Administrador</option>
              <option value="Supervisor">Supervisor</option>
              <option value="Trabajador de Campo" selected>Trabajador de Campo</option>
              <option value="Tecnico Electronico">Tecnico Electronico</option>
              <option value="Jefe de Inventario">Jefe de Inventario</option>
              <option value="Responsable SST">Responsable SST</option>
              <option value="Gerente">Gerente</option>
            </select>
          </div>
          <div class="form-group">
            <label for="salario_base">Salario base:</label>
            <input type="number" step="0.01" id="salario_base" name="salario_base">
          </div>
          <div class="form-group">
            <label for="codigo_qr">Codigo QR:</label>
            <input type="text" id="codigo_qr" name="codigo_qr">
          </div>
          <div class="form-group">
            <label for="estado">Estado:</label>
            <select id="estado" name="estado">
              <option value="Activo" selected>Activo</option>
              <option value="Inactivo">Inactivo</option>
            </select>
          </div>
          <div class="form-group">
            <label for="fecha_ingreso">Fecha de ingreso:</label>
            <input type="date" id="fecha_ingreso" name="fecha_ingreso">
          </div>
        </div>

        <div style="display: flex; gap: 1rem; margin-top: 1rem;">
          <button type="submit" class="btn btn-primary">Guardar</button>
          <a href="/empleados" class="btn btn-secondary">Cancelar</a>
        </div>
      </form>
    </div>
  </div>
</body>
</html>
