<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGA - Editar Empleado</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <h1>SIGA - AGROSERVICES</h1>
    <div class="navbar-links">
      <a href="/empleados">&larr; Volver</a>
      <a href="/logout">Cerrar Sesion</a>
    </div>
  </nav>

  <div class="container">
    <div class="card">
      <h1>Editar Empleado</h1>

      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>

      <form action="/empleados/editar" method="POST">
        <input type="hidden" name="id" value="<%= empleado.id_empleado %>">

        <div class="grid-2">
          <div class="form-group">
            <label for="nombre">Nombre:</label>
            <input type="text" id="nombre" name="nombre" value="<%= empleado.nombre %>" required>
          </div>
          <div class="form-group">
            <label for="documento">Documento:</label>
            <input type="text" id="documento" name="documento" value="<%= empleado.documento %>" required>
          </div>
          <div class="form-group">
            <label for="email">Email:</label>
            <input type="email" id="email" name="email" value="<%= empleado.email %>" required>
          </div>
          <div class="form-group">
            <label for="telefono">Telefono:</label>
            <input type="text" id="telefono" name="telefono" value="<%= empleado.telefono || '' %>">
          </div>
          <div class="form-group">
            <label for="rol">Rol:</label>
            <select id="rol" name="rol" required>
              <% const roles = ['Administrador','Supervisor','Trabajador de Campo','Tecnico Electronico','Jefe de Inventario','Responsable SST','Gerente']; %>
              <% roles.forEach(r => { %>
                <option value="<%= r %>" <%= empleado.rol === r ? 'selected' : '' %>><%= r %></option>
              <% }); %>
            </select>
          </div>
          <div class="form-group">
            <label for="salario_base">Salario base:</label>
            <input type="number" step="0.01" id="salario_base" name="salario_base" value="<%= empleado.salario_base || '' %>">
          </div>
          <div class="form-group">
            <label for="codigo_qr">Codigo QR:</label>
            <input type="text" id="codigo_qr" name="codigo_qr" value="<%= empleado.codigo_qr || '' %>">
          </div>
          <div class="form-group">
            <label for="estado">Estado:</label>
            <select id="estado" name="estado">
              <option value="Activo" <%= empleado.estado === 'Activo' ? 'selected' : '' %>>Activo</option>
              <option value="Inactivo" <%= empleado.estado === 'Inactivo' ? 'selected' : '' %>>Inactivo</option>
            </select>
          </div>
          <div class="form-group">
            <label for="fecha_ingreso">Fecha de ingreso:</label>
            <input type="date" id="fecha_ingreso" name="fecha_ingreso"
                   value="<%= empleado.fecha_ingreso ? String(empleado.fecha_ingreso).substring(0,10) : '' %>">
          </div>
        </div>

        <div style="display: flex; gap: 1rem; margin-top: 1rem;">
          <button type="submit" class="btn btn-primary">Actualizar</button>
          <a href="/empleados" class="btn btn-secondary">Cancelar</a>
        </div>
      </form>
    </div>
  </div>
</body>
</html>
