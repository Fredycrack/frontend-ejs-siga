<dialog id="dlg-movimiento">
  <div class="dialogo-cabeza"><h2 data-texto="titulo">Movimiento</h2><button class="cerrar" type="button" data-cerrar>&times;</button></div>
  <div class="dialogo-cuerpo">
    <form data-api="" data-metodo="POST">
      <div class="aviso error aviso-formulario oculto" role="alert"></div>
      <p style="margin-bottom:.8rem"><strong data-texto="producto"></strong> &middot; Disponible: <span data-texto="disponible"></span></p>
      <div class="campo"><label class="requerido" for="mv-cantidad">Cantidad</label><input type="number" id="mv-cantidad" name="cantidad" min="0.01" step="0.01" required></div>
      <div class="campo" style="margin-top:.8rem"><label for="mv-ref">Referencia</label><input id="mv-ref" name="referencia" maxlength="100" placeholder="Factura de compra, labor, equipo..."></div>
      <div class="pie-formulario"><button class="btn" type="button" data-cerrar>Cancelar</button><button class="btn btn-primario" type="submit">Registrar</button></div>
    </form>
  </div>
</dialog>
