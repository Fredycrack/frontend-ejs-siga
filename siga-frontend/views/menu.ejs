<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGA - Menu Principal</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <h1>SIGA - AGROSERVICES</h1>
    <div class="navbar-links">
      <a href="/empleados">Empleados</a>
      <a href="/logout">Cerrar Sesion</a>
    </div>
  </nav>

  <div class="container">
    <div class="card" style="text-align: center;">
      <h1>Bienvenido<% if (empleado) { %>, <%= empleado.nombre %><% } %></h1>
      <% if (empleado) { %>
        <p class="badge"><%= empleado.rol %></p>
      <% } %>
      <p style="margin: 1.5rem 0; color: #555;">
        Modulo de Administracion de Empleados del Sistema Integrado de Gestion.
      </p>

      <div style="display: flex; gap: 1rem; justify-content: center; margin-top: 2rem;">
        <a href="/empleados" class="btn btn-primary">Gestionar Empleados</a>
        <a href="/logout" class="btn btn-secondary">Cerrar Sesion</a>
      </div>
    </div>
  </div>
</body>
</html>
