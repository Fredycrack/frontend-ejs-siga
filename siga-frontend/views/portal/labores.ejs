<%- include('../partials/arriba', { titulo: 'Labores programadas' }) %>
<%- include('../partials/encabezado', { titulo: 'Labores en sus cultivos', subtitulo: 'Avance de las labores agricolas de sus contratos.' }) %>
<div class="tarjeta">
  <% if (!labores.length) { %><p class="vacio">No hay labores registradas.</p><% } else { %>
  <div class="tabla-contenedor"><table>
    <thead><tr><th>Labor</th><th>Contrato</th><th>Fecha</th><th>Estado</th><th class="num">Cumplimiento</th></tr></thead>
    <tbody><% labores.forEach(function (l) { %>
      <tr><td><strong><%= l.tipo_labor %></strong><div class="tenue pequeno"><%= l.ubicacion %></div></td><td><%= l.numero_contrato %></td>
        <td class="nowrap"><%= f.fecha(l.fecha_programada) %><div class="tenue pequeno"><%= f.hora(l.hora_programada) %></div></td>
        <td><%- include('../partials/estado', { valor: l.estado }) %></td><td class="num"><%= l.porcentaje_cumplimiento === null ? '—' : l.porcentaje_cumplimiento + ' %' %></td></tr>
    <% }) %></tbody>
  </table></div>
  <% } %>
</div>
<%- include('../partials/abajo') %>
